{
  "name": "@allkons/ui",
  "version": "1.0.1",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build && npm run copy-css && npm run copy-styles",
    "copy-css": "find src -name '*.css' -exec sh -c 'mkdir -p dist/$(dirname ${1#src/}) && cp $1 dist/${1#src/}' _ {} \\;",
    "copy-styles": "cp src/styles.css dist/styles.css"
  },
  "peerDependencies": {
    "antd": ">=5.25.1",
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "antd": "^5.29.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
}
